# Server
SERVER_PORT=8080

# Redis connection
REDIS_ADDR=redis:6379
REDIS_PASSWORD=
REDIS_DB=0

# Rate limits (requests per second)
IP_RATE_LIMIT=10
TOKEN_RATE_LIMIT=100

# Per-token overrides: "token:limit,token2:limit2"
# These win over both TOKEN_RATE_LIMIT and IP_RATE_LIMIT (Token > IP).
TOKEN_LIMITS=abc123:100,premium:1000

# How long an offending IP/token stays blocked, in seconds.
BLOCK_DURATION_SECONDS=300
